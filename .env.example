# Copy this file to `.env` (which is git-ignored) and paste your EconData
# PERSONAL API TOKEN — the long JWT string from the EconData portal
# (starts with "eyJ..."). Tokens are valid ~24 hours; when fetches fail
# with an "expired" error, log in to the portal and paste a fresh one.
#
# (Legacy "client_id;client_secret" pairs also still work here, if your
# account has them — the client detects the format automatically.)
ECONDATA_CREDENTIALS=eyJ...paste-your-token-here...
